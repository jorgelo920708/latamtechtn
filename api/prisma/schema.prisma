generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  adminId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model TalentLead {
  id        String   @id @default(uuid())
  name      String
  company   String
  email     String
  role      String
  specialty String
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model CandidateApplication {
  id                  String   @id @default(uuid())
  fullName            String
  email               String
  phone               String?
  location            String
  specialty           String?
  linkedinUrl         String?
  cvUrl               String?
  mainRole            String?
  otherRoles          String?
  mainStack           String?
  yearsExperience     String?
  englishLevel        String
  workedInternational Boolean  @default(false)
  willingContractor   Boolean?
  jobSearchStatus     String?
  desiredSalary       Int?
  minSalary           Int?
  availability        String?
  message             String?
  status              String   @default("NEW")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model CvFile {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}
