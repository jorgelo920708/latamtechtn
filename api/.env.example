# === PostgreSQL ===
# En Railway, configura ambas variables como ${{Postgres.DATABASE_URL}}.
# En desarrollo, usa un PostgreSQL local o la conexión pública de Railway.
DATABASE_URL="postgresql://postgres:password@localhost:5432/latamtechtn"
DIRECT_URL="postgresql://postgres:password@localhost:5432/latamtechtn"

PORT=3000
CORS_ORIGINS="https://latamtechtn.com,https://www.latamtechtn.com"

# === Admin / Auth ===
# JWT_SECRET: genera uno largo y aleatorio con: openssl rand -hex 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="elbacaseres83@gmail.com"
ADMIN_INITIAL_PASSWORD="LatamTalent2026!"

# === Email (Resend) — opcional ===
# Sin RESEND_API_KEY las notificaciones y el reset NO se envían (la app NO se rompe).
RESEND_API_KEY=""
MAIL_FROM="LATAM Tech Talent Network <noreply@latamtechtn.com>"
WEB_URL="https://www.latamtechtn.com"
